OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EVALUATION_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_EVALUATION_MAX_OUTPUT_TOKENS=2400
OPENAI_HIGHER_ANSWER_MAX_OUTPUT_TOKENS=900
OPENAI_PROMPT_CACHE_ENABLED=false
OPENAI_PROMPT_CACHE_TTL=30m
OPENAI_RATE_LIMIT_MAX_RETRIES=1
OPENAI_RATE_LIMIT_RETRY_DELAY_SECONDS=0.5
APP_ENVIRONMENT=development
OPENAI_USAGE_LOG_ENABLED=false
EVALUATION_PROMPT_VERSION=v2
EVALUATION_SCHEMA_VERSION=v2
EVALUATION_V2_PROMPT_VERSION=v1
EVALUATION_V2_SCHEMA_VERSION=v1
HIGHER_ANSWER_PROMPT_VERSION=v1
HIGHER_ANSWER_SCHEMA_VERSION=v1
EVALUATION_CACHE_TTL_SECONDS=300
EVALUATION_CACHE_MAX_ENTRIES=128
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_AUDIO_BYTES=900000
