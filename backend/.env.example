AI_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_CONCURRENT_EVALUATIONS=1
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_INVALID_RESPONSE_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_EVALUATION_MAX_OUTPUT_TOKENS=4000
OLLAMA_HIGHER_ANSWER_MAX_OUTPUT_TOKENS=900
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=en
WHISPER_LOCAL_FILES_ONLY=true
WHISPER_VAD_ENABLED=true
WHISPER_VAD_THRESHOLD=0.35
WHISPER_VAD_MIN_SPEECH_DURATION_MS=0
WHISPER_VAD_MIN_SILENCE_DURATION_MS=1000
WHISPER_VAD_SPEECH_PAD_MS=500

APP_ENVIRONMENT=development
USAGE_LOG_ENABLED=false
EVALUATION_PROMPT_VERSION=v2
EVALUATION_SCHEMA_VERSION=v2
EVALUATION_V2_PROMPT_VERSION=v1
EVALUATION_V2_SCHEMA_VERSION=v1
HIGHER_ANSWER_PROMPT_VERSION=v1
HIGHER_ANSWER_SCHEMA_VERSION=v1
EVALUATION_CACHE_TTL_SECONDS=300
EVALUATION_CACHE_MAX_ENTRIES=128
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_AUDIO_BYTES=900000
